    "png/glitch_strip_06.png",
    "png/glitch_strip_07.png"
   ],
   "blend": "add"
  }
 ],
 "bindings": [
  {
   "event": "ZoneState",
   "element": "layers_player / layers_enemy / body_*",
   "behavior": "Recolour the zone (a = new ZoneState) with the style from states.json; Critical blinks; actor decides the player or the enemy silhouette."
  },
  {
   "event": "HitEvent",
   "element": "layers_*, alarm_frame, cracks",
   "behavior": "Pulse the hit zone outline (0.25 s); layer reached (a) shortens that layer arc; severity b >= Exposed spawns the plate marks; S2+ adds a crack mask, S3+ soot."
  },
  {
   "event": "ArmorPlateLost",
   "element": "body_* (shard marks)",
   "behavior": "Small shard ticks fly off the zone outline; the Armor arc loses 1/b of its length."
  },
  {
   "event": "ReactorBreach",
   "element": "body_player zone_Reactor, alarm_frame",
   "behavior": "Reactor hex turns red and blinks 4 Hz for 8 s, red edge frame on."
  },
  {
   "event": "SystemFailure",
   "element": "weapons, gauge_*, priority, radar",
   "behavior": "The matching widget shows a dead state (dotted outline, no fill); a = SystemId (Sensors -> radar + lock-on quality 0, Power -> gauge_energy, Cooling -> gauge_heat, Weapon -> weapons)."
  },
  {
   "event": "LimbSevered",
   "element": "body_* zone",
   "behavior": "Zone drawn as Severed (dotted + slash); an arm hides its weapon-hand icon."
  },
  {
   "event": "StaggerBegin",
   "element": "gauge_stability, alarm_frame",
   "behavior": "Stability ring flashes orange; short horizontal glitch strip."
  },
  {
   "event": "StaggerEnd",
   "element": "gauge_stability",
   "behavior": "Flash stops."
  },
  {
   "event": "Knockdown",
   "element": "alarm_frame, glitch_strips",
   "behavior": "Signal loss 0.6 s (glitch strip alpha 1), red edge frame pulse."
  },
  {
   "event": "HeatWarning",
   "element": "gauge_heat",
   "behavior": "Ring turns orange then red above the hot threshold and blinks 2 Hz."
  },
  {
   "event": "CoolantLeak",
   "element": "gauge_heat, body_player",
   "behavior": "Heat ring drips marks; the torso outline blinks amber."
  },
  {
   "event": "Shutdown",
   "element": "all persistent elements",
   "behavior": "Everything dims to 25 % except alarm_frame and gauge_energy (power loss)."
  },
  {
   "event": "EnergyShift",
   "element": "priority",
   "behavior": "The new priority pictogram lights, the old one fades (0.3 s)."
  },
  {
   "event": "StatusApplied",
   "element": "enemy_status, body_player corner",
   "behavior": "Show the status icon (a = StatusKind: Blind, StrikeLock, Burn) with a duration ring (b ticks); actor chooses the player or the enemy side."
  },
  {
   "event": "StatusEnded",
   "element": "enemy_status",
   "behavior": "Remove the status icon."
  },
  {
   "event": "WeaponCharging",
   "element": "weapons",
   "behavior": "The weapon icon fills a ring."
  },
  {
   "event": "WeaponFired",
   "element": "weapons",
   "behavior": "Icon flash, cooldown ring starts from full."
  },
  {
   "event": "WeaponReady",
   "element": "weapons",
   "behavior": "Ring completes, icon pulses once (a = WeaponKind)."
  },
  {
   "event": "WeaponEmpty",
   "element": "weapons",
   "behavior": "Icon turns red and dotted."
  },
  {
   "event": "UltimateReady",
   "element": "ultimate",
   "behavior": "Ring full: white blink 2 Hz."
  },
  {
   "event": "UltimateUsed",
   "element": "ultimate",
   "behavior": "Ring empties with a sweep."
  },
  {
   "event": "WindupStarted",
   "element": "threat_arrows, strike_arc",
   "behavior": "Threat arrow in the attack direction (b = SwingSide) with a wide sector; narrows after the commit."
  },
  {
   "event": "Committed",
   "element": "threat_arrows",
   "behavior": "The arrow turns solid red and the sector collapses into a line."
  },
  {
   "event": "StrikeContact",
   "element": "alarm_frame",
   "behavior": "Single white-red flash of the edges at the contact moment."
  },
  {
   "event": "ExternalHit",
   "element": "alarm_frame, threat_arrows",
   "behavior": "Arrow from the side of the source (a: 0 debris, 1 building, 2 fall)."
  },
  {
   "event": "BurnTick",
   "element": "status_icons_burn, soot_masks",
   "behavior": "Burn icon pulses; soot grows by one step every 5 ticks."
  },
  {
   "event": "BoardingSwatTelegraph",
   "element": "threat_arrows, alarm_frame",
   "behavior": "Corner arrow on the shoulder side (a), the edge frame fills during b ticks until impact."
  },
  {
   "event": "HackProgress",
   "element": "distance, lockon_ring",
   "behavior": "Progress arc around the crosshair (value 0..1)."
  },
  {
   "event": "MatchEnd",
   "element": "all",
   "behavior": "Fade everything out over 1 s (a = EndReason)."
  }
 ],
 "state_inputs": {
  "note": "What the game passes each frame (lib/presets.py shows complete examples).",
  "player/enemy": "zones{Zone: ZoneState name}, layers{Zone: [armor, mechanism, system] remaining 0..1}",
  "scalars": [
   "armor",
   "stability",
   "heat",
   "energy",
   "ultimate{value, ready}",
   "arm_armor[L, R]",
   "priority (EnergyPriority)",
   "heading",
   "distance_m",
   "clock_s"
  ],
  "weapons": "{rail|rockets|plasma: {ring 0..1, dead, empty}}",
  "lock": "{rect (fractions), quality 0..1, hex, hex_hot}",
  "strike": "{points (fractions), committed}",
  "threats": "list of up|down|left|right",
  "glass": "{cracks[idx], soot[idx], drops N, glitch 0..1, alarm 0..1}"
 }
}
