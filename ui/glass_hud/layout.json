  "16:9": {
   "ratio": 1.7778,
   "rule": "uniform UI scale = height/1080 for ratio >= 16:9, width/1920 below; corner offsets scale with it; centred elements stay centred"
  },
  "21:9": {
   "ratio": 2.3333,
   "rule": "uniform UI scale = height/1080 for ratio >= 16:9, width/1920 below; corner offsets scale with it; centred elements stay centred"
  },
  "16:10": {
   "ratio": 1.6,
   "rule": "uniform UI scale = height/1080 for ratio >= 16:9, width/1920 below; corner offsets scale with it; centred elements stay centred"
  }
 },
