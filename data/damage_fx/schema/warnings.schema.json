{
 "title": "warnings",
 "type": "object",
 "required": [
  "version",
  "colors",
  "warnings"
 ],
 "properties": {
  "version": {
   "type": "integer"
  },
  "colors": {
   "type": "object",
   "additionalProperties": {
    "type": "string",
    "pattern": "^#[0-9A-Fa-f]{6}$"
   }
  },
  "warnings": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "id",
     "trigger",
     "priority",
     "color",
     "blink_ms",
     "sound",
     "hud_icon",
     "voice"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
     },
     "trigger": {
      "type": "object",
      "required": [
       "event"
      ]
     },
     "priority": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
     },
     "color": {
      "type": "string"
     },
     "blink_ms": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
       "type": "integer",
       "minimum": 0
      }
     }
    }
   }
  }
 },
 "$schema": "https://json-schema.org/draft/2020-12/schema"
}
