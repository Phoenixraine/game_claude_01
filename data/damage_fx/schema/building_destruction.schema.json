{
 "title": "building destruction",
 "type": "object",
 "required": [
  "version",
  "budgets",
  "classes",
  "dust",
  "scenarios",
  "smoke_puffs",
  "sounds",
  "material_scale"
 ],
 "properties": {
  "version": {
   "type": "integer"
  },
  "budgets": {
   "type": "object",
   "required": [
    "large_shards",
    "small_shards",
    "smoke_puffs",
    "cpu_particle_tick_hz"
   ],
   "properties": {
    "large_shards": {
     "type": "integer",
     "maximum": 400
    },
    "small_shards": {
     "type": "integer",
     "maximum": 6000
    },
    "smoke_puffs": {
     "type": "integer",
     "maximum": 80
    },
    "cpu_particle_tick_hz": {
     "type": "integer",
     "minimum": 1
    }
   }
  },
  "classes": {
   "type": "object",
   "additionalProperties": {
    "enum": [
     "large",
     "small"
    ]
   }
  },
  "dust": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": [
     "color",
     "density"
    ],
    "properties": {
     "color": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
       "type": "number"
      }
     },
     "density": {
      "type": "array",
      "minItems": 2,
      "items": {
       "type": "array",
       "minItems": 2,
       "maxItems": 2,
       "items": {
        "type": "number"
       }
      }
     }
    }
   }
  },
  "scenarios": {
   "type": "object",
   "required": [
    "sword_hit",
    "mech_crash",
    "thrown_debris",
    "plasma",
    "rockets"
   ],
   "additionalProperties": {
    "type": "object",
    "required": [
     "energy_ref_kj",
     "stages"
    ],
    "properties": {
     "energy_ref_kj": {
      "type": "number",
      "minimum": 0.1
     },
     "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "required": [
        "name",
        "spawns"
       ],
       "properties": {
        "name": {
         "type": "string"
        },
        "spawns": {
         "type": "array",
         "items": {
          "type": "object",
          "required": [
           "class",
           "count",
           "t_s",
           "speed_mps",
           "cone_deg",
           "mass_kg",
           "life_s"
          ],
          "properties": {
           "class": {
            "type": "string"
           },
           "count": {
            "type": "number",
            "minimum": 0
           },
           "t_s": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
           },
           "speed_mps": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
             "type": "number"
            }
           },
           "cone_deg": {
            "type": "number",
            "minimum": 0,
            "maximum": 180
           },
           "mass_kg": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
             "type": "number"
            }
           },
           "life_s": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
             "type": "number"
            }
           }
          }
         }
        }
       }
      }
     }
    }
   }
  },
  "smoke_puffs": {
   "type": "object",
   "required": [
    "base",
    "per_energy_unit",
    "max",
    "lifetime_s"
   ],
   "properties": {
    "max": {
     "type": "integer",
     "maximum": 80
    }
   }
  },
  "sounds": {
   "type": "object",
   "additionalProperties": {
    "type": "string"
   }
  },
  "material_scale": {
   "type": "object"
  }
 },
 "$schema": "https://json-schema.org/draft/2020-12/schema"
}
